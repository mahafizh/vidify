# --- MySQL ---
DB_NAME=vidify
DB_USER=vidify
DB_PASSWORD=ganti-password-ini
DB_ROOT_PASSWORD=ganti-juga-ini

# --- Library ---
# Path absolut folder film di home server
MEDIA_ROOT=/mnt/media

# Alamat bind port 3000. Biarkan 127.0.0.1 kalau hanya diakses lewat Cloudflare Tunnel.
# Set 0.0.0.0 kalau mau dibuka dari HP via Tailscale/LAN.
# APP_BIND=127.0.0.1
# APP_PORT=3000

# --- Cloudflare Tunnel ---
# Dashboard Zero Trust > Networks > Tunnels > token
TUNNEL_TOKEN=

# --- Opsional ---
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# --- Mode image dari registry (deploy.sh --pull) ---
# VIDIFY_IMAGE=ghcr.io/username/vidify:latest

# --- Hanya untuk docker-compose.nas.yml (media di NAS / share SMB) ---
# SMB_SHARE=//192.168.100.10/data
# SMB_SUBPATH=/Hafizh/Dracin
# SMB_USER=
# SMB_PASSWORD=
# SMB_VERSION=3.0
